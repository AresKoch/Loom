{
  "name": "loom",
  "productName": "Loom",
  "version": "1.8.6",
  "description": "A file browser with Claude Code and git built in. Folders flow left to right as wired columns.",
  "main": "main.js",
  "author": "Ares Kochendorfer",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-packager . Loom --platform=win32 --arch=x64 --out=dist --asar --overwrite --ignore=\"^/docs\" --ignore=\"^/test\" --ignore=\"^/\\.github\" --ignore=\"^/dist\" --ignore=\"READ ME FIRST\\.txt\" --ignore=\"README\\.md\" --ignore=\"^/node_modules\" --ignore=\"^/\\.git\""
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "@electron/packager": "^18.3.6"
  }
}
